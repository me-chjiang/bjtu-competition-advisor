  "components": {
    "schemas": {
      "CandidateCard": {
        "properties": {
          "competition_instance_id": {
            "type": "string",
            "minLength": 1,
            "title": "Competition Instance Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "registration_status": {
            "type": "string",
            "enum": [
              "open",
              "upcoming",
              "closed",
              "unknown"
            ],
            "title": "Registration Status",
            "default": "unknown"
          },
          "registration_deadline": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Registration Deadline"
          },
          "eligibility": {
            "type": "string",
            "enum": [
              "eligible",
              "ineligible",
              "unknown"
            ],
            "title": "Eligibility",
            "default": "unknown"
          },
          "decision": {
            "type": "string",
            "enum": [
              "keep",
              "exclude",
              "defer"
            ],
            "title": "Decision",
            "default": "defer"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "dimensions": {
            "items": {
