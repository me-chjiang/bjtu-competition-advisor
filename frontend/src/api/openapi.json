            "type": "array",
            "title": "Dimensions"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "type": "array",
            "title": "Evidence"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "competition_instance_id",
          "name",
          "reason"
        ],
        "title": "CandidateCard"
      },
      "CandidatePatchRequest": {
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Revision"
          },
          "decision": {
            "type": "string",
            "enum": [
              "keep",
              "exclude",
              "defer"
            ],
            "title": "Decision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_revision",
          "decision"
        ],
        "title": "CandidatePatchRequest"
      },
      "ChatRequest": {
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1,
            "title": "Request Id"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Revision"
          },
          "action": {
            "type": "string",
            "enum": [
              "message",
              "generate"
            ],
            "title": "Action"
          },
          "content": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4000
              },
              {
                "type": "null"
              }
            ],
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "expected_revision",
          "action",
          "content"
        ],
        "title": "ChatRequest"
      },
      "CompetitionDetail": {
        "properties": {
          "competition_instance_id": {
            "type": "string",
