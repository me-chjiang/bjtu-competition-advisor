{
  "name": "bjtu-competition-advisor-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "gen:api": "cd .. && uv run python scripts/export-openapi.py > frontend/src/api/openapi.json && cd frontend && openapi-typescript src/api/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "markdown-it": "^15.0.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.2",
    "openapi-typescript": "^7.13.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.13"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
